<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>Retro Gridiron</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
:root{--bg:#10151f;--fg:#fff;--bl:#2d63ff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html,body{margin:0;background:var(--bg);color:var(--fg);font-family:'Press Start 2P',monospace,sans-serif;font-size:11px}
#wrap{max-width:900px;margin:0 auto}
#hud{background:#000;display:flex;justify-content:space-between;padding:10px 12px;font-size:12px}
#cvw{position:relative}canvas{width:100%;display:block;image-rendering:pixelated;touch-action:none}
#toast{position:absolute;left:0;right:0;top:40%;text-align:center;font-size:16px;text-shadow:2px 2px #000;pointer-events:none}
#info{padding:8px 12px;font-size:9px;color:#9bb}
#bar{display:flex;gap:8px;flex-wrap:wrap;padding:8px 12px;min-height:30px;align-items:center}
button{font:inherit;font-size:10px;background:#000;color:#fff;border:2px solid #fff;padding:10px 12px;cursor:pointer}
button:hover{background:#333}button.on{background:#f5d000;color:#000}
#ui{position:fixed;inset:0;z-index:10;overflow-y:auto;background:var(--bl);display:flex;flex-direction:column;align-items:center;padding:24px 12px;gap:12px;text-align:center}
#ui.hide{display:none}
.line{position:fixed;left:0;right:0;top:64%;height:6px;background:#f5d000;z-index:-1}.line:after{content:'';position:absolute;left:0;right:0;top:12px;height:6px;background:var(--lc,#2c2)}
h1{font-size:26px;margin:20px 0;text-shadow:3px 3px #000}h2{margin:4px}
table{border-collapse:collapse;font-size:10px}td,th{padding:6px 8px;border-bottom:1px solid #fff5}
.r{font-size:10px;line-height:1.6}.tabs{display:flex;gap:6px;flex-wrap:wrap;justify-content:center}
#ui button{background:var(--bl)}#ui button:hover{background:#4a80ff}
.top{display:flex;justify-content:space-between;align-items:center;width:100%;max-width:980px;gap:8px}
.ttl{font-size:clamp(12px,3vw,24px);text-shadow:3px 3px #000}.ss{color:#c33}.sb{color:#223a9a}
.pill,.bx{border:3px solid #fff;border-radius:6px;padding:8px 10px;position:relative;font-size:10px}
.bl{position:absolute;top:-8px;left:10px;background:var(--bl);padding:0 6px;font-size:9px}
.bx{margin-top:6px}.fl,.cap{flex:1;min-width:220px}.row2{display:flex;gap:8px;width:100%;max-width:700px;align-items:center}
.band{width:100vw;background:#d3d10a;display:flex;justify-content:space-around;padding:10px 0;font-size:10px;line-height:1.8;text-shadow:2px 2px #000}
.nd{width:33%;min-height:60px}.dot{display:block;margin:6px auto;width:44px;height:18px;border-radius:50%;background:#fff;border:3px solid #555}.dot.g{background:#0d0}
.row{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;width:100%;max-width:980px}.half{flex:1;min-width:260px}.col{display:flex;flex-direction:column;gap:8px}
.me td{color:#fd0}.nav{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;align-items:center}
.grid{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:980px}.w{display:flex;flex-direction:column;align-items:center;gap:6px}
.cd{width:118px;border:3px solid #fff;border-radius:4px;background:#333}.clk{cursor:pointer}.clk:hover{transform:translateY(-3px)}
.ph{position:relative;height:84px;display:flex;justify-content:center;align-items:flex-end;overflow:hidden}.ph b{position:absolute;left:5px;top:4px;font-size:10px;text-shadow:1px 1px #000}.ph .sm{position:absolute;right:5px;top:4px}
.nm{background:#555;padding:6px 2px;font-size:10px;line-height:1.6}.st{display:block;font-size:13px;background:linear-gradient(90deg,var(--c,#fd0) var(--p),#222 var(--p));-webkit-background-clip:text;background-clip:text;color:transparent}
.en{height:8px;background:#999;margin:3px}.en i{display:block;height:100%;background:#0f0}
.sm{width:18px;height:18px;border-radius:5px;border:2px solid #000;display:inline-block;vertical-align:middle}
.co{display:inline-block;width:14px;height:14px;border-radius:50%;background:#fd0;border:2px solid #000;margin-left:4px;vertical-align:middle}
.bar{height:18px;background:#000;border:3px solid #fff}.bar i{display:block;height:100%;background:#d3d10a}
.seg{display:flex;gap:4px;background:#000;padding:6px}.seg b{flex:1;height:20px;background:#222}.seg b.f{background:#d3d10a}
.det{text-align:left;line-height:2;font-size:11px;margin-top:6px}.x{position:fixed;top:10px;right:10px;z-index:20;font-size:16px;padding:8px 12px}.top{padding-right:46px;box-sizing:border-box}</style></head><body>
<div id="wrap"><div id="hud"></div><div id="cvw"><canvas id="c" width="900" height="420"></canvas><div id="toast"></div></div><div id="info"></div><div id="bar"></div></div>
<div id="ui"></div><div class="line" id="ln" style="display:none"></div>
<script>
const $=i=>document.getElementById(i),cv=$('c'),x=cv.getContext('2d'),W=900,H=420,SX=14,SY=7.2;
const R=(a,b)=>a+Math.random()*(b-a),RI=(a,b)=>Math.floor(R(a,b+1)),cl=(v,a,b)=>Math.max(a,Math.min(b,v)),pk=a=>a[RI(0,a.length-1)],av=a=>a.reduce((s,v)=>s+v,0)/a.length;
const SL=['QB','WR','WR','WR','RB','OL','DEF','K'],FN='JTMDSCARBL'.split(''),LN=['Jacobs','Smith','Reed','Cole','Banks','Ellis','Stone','Price','Hayes','Moss','Cruz','Webb','Ford','Gray'];
const OPS=['ATL','DAL','GB','KC','SF','PIT','MIA','SEA'],TC=[{j:'#f2f2f2',h:'#e8c020'},{j:'#2a2a2a',h:'#c02828'}];
const AUD=['DEEP','SHORT','MIX'];
const ROUTES=[[[[28,0]],[[10,0],[26,10]],[[12,0],[28,-14]],[[2,6]]],[[[6,0],[8,-4]],[[5,0],[9,8]],[[8,0],[6,-3]],[[3,8],[9,10]]],[[[10,0],[22,6]],[[4,0],[12,-8]],[[18,0]],[[4,-8]]]];
const eo=(t,i)=>t[i].ovr-(t[i].inj?15:0);
let G,g=null,p=null,cam=50,tab='Roster',tt;
function genFA(){G.fa=[...Array(6)].map(()=>{const i=RI(0,7),pl=mkP(SL[i],RI(65,86));pl.i=i;pl.cost=(pl.ovr-55)*4;return pl})}
function genDr(){G.dr=[...Array(6)].map(()=>{const i=RI(0,7),pl=mkP(SL[i],RI(58,84));pl.i=i;return pl})}
function genTr(){G.tr=[...Array(3)].map(()=>{const i=RI(0,7),pl=mkP(SL[i],RI(76,90));pl.i=i;return pl})}
function newOpp(){if(G.po)return;G.opp={n:OPS[(G.wk-1)%8],s:58+G.wk*3+RI(-3,3)}}
function fresh(){G={wk:1,w:0,l:0,fans:100,cr:300,cap:100,morale:70,fac:{stadium:0,training:0,rehab:0,staff:0},picks:2,draft:true,last:null,team:SL.map(s=>mkP(s,RI(62,74)))};genFA();genDr();genTr();newOpp()}
function save(){try{localStorage.setItem('rg_save',JSON.stringify(G))}catch(e){}}
try{G=JSON.parse(localStorage.getItem('rg_save'))}catch(e){}if(!G||!G.team)fresh();
const used=()=>G.team.reduce((s,v)=>s+v.sal,0);
/* audio */
let ac;function cheer(){try{ac=ac||new AudioContext();const n=ac.sampleRate*1.6,b=ac.createBuffer(1,n,ac.sampleRate),d=b.getChannelData(0);for(let i=0;i<n;i++)d[i]=(Math.random()*2-1)*Math.sin(Math.PI*i/n);const s=ac.createBufferSource();s.buffer=b;const f=ac.createBiquadFilter();f.type='bandpass';f.frequency.value=900;const o=ac.createGain();o.gain.value=.5;s.connect(f).connect(o).connect(ac.destination);s.start()}catch(e){}}
function toast(m){$('toast').textContent=m;clearTimeout(tt);tt=setTimeout(()=>$('toast').textContent='',2000)}
/* menus */
const ui=h=>{$('ui').innerHTML=h;$('ui').className=''},hide=()=>{$('ui').className='hide';$('ln').style.display='none'};
const TEAMS=[{n:'NEW ENGLAND',a:'N.E',c:'#1a2a5a',h:'#c02828',s:70},{n:'MIAMI',a:'MIA',c:'#0aa0a0',h:'#f08020',s:68},{n:'BUFFALO',a:'BUF',c:'#2060d0',h:'#d03030',s:66},{n:'NEW YORK A',a:'NYA',c:'#208040',h:'#eeeeee',s:60},{n:'ATLANTA',a:'ATL',c:'#222222',h:'#d02020',s:64},{n:'DALLAS',a:'DAL',c:'#aab0c0',h:'#2040a0',s:72},{n:'GREEN BAY',a:'GB',c:'#1a5a30',h:'#e8c020',s:69},{n:'KANSAS CITY',a:'KC',c:'#d02020',h:'#e8c020',s:78}];
const TM=a=>TEAMS.find(t=>t.a==a),ME=()=>TEAMS[G.tm];
function mkP(s,o){return{slot:s,name:pk(FN)+'.'+pk(LN),ovr:o,sal:Math.max(1,Math.round((o-45)/4)),inj:0,sk:RI(0,3),hr:RI(0,3)}}
function fresh(){G={wk:1,yr:1,w:0,l:0,fans:100,cr:300,cap:100,morale:70,fac:{stadium:0,training:0,rehab:0,staff:0},picks:3,draft:true,last:null,hist:{},tm:-1,team:SL.map(s=>mkP(s,70))};genFA();genDr();genTr()}
function newOpp(){if(G.po)return;const o=G.sch[G.wk-1];G.opp={n:o.n,s:TM(o.n).s}}
function newSeason(){const o=TEAMS.filter((_,i)=>i!=G.tm);G.sch=[...Array(8)].map((_,i)=>({n:o[i%7].a,h:i%2==0}));G.st={};TEAMS.forEach(t=>G.st[t.a]=[0,0])}
function simLeague(){TEAMS.forEach((t,i)=>{if(i!=G.tm)Math.random()<.3+(t.s-55)/80?G.st[t.a][0]++:G.st[t.a][1]++})}
const SK=['#f0c0a0','#c68642','#8d5524','#5a3a22'],HR=['#222','#a52','#e0b040','#111'];
const face=(a,j)=>`<svg viewBox="0 0 16 16" width=70 height=70 shape-rendering=crispEdges><rect x=2 y=11 width=12 height=5 fill="${j}"/><rect x=5 y=4 width=6 height=7 fill="${SK[a.sk||0]}"/><rect x=5 y=3 width=6 height=2 fill="${HR[a.hr||0]}"/><rect x=6 y=7 width=1 height=1 /><rect x=9 y=7 width=1 height=1 /></svg>`;
const stars=(o,c)=>`<span class=st style="--p:${cl((o-40)/55*100,0,100)}%;--c:${c||'#fd0'}">★★★★★</span>`;
const smile=m=>`<i class=sm style="background:${m>70?'#fd0':m>50?'#f90':m>30?'#e22':'#3af'}"></i>`,co=n=>`${n}<i class=co></i>`;
const bx=(t,i,c)=>`<div class="bx ${c||''}"><span class=bl>${t}</span>${i}</div>`;
const mean=ix=>ix.reduce((s,i)=>s+eo(G.team,i),0)/ix.length;
const hdr=(t,r,b)=>`<div class=top><div class=pill>${co(G.cr)}</div><div class=ttl><span class=ss>★</span>★<span class=sb>★</span> ${t} <span class=sb>★</span>★<span class=ss>★</span></div><div class=pill>${r||'&nbsp;'}</div></div>`+(b?`<button class=x onclick="${b}">✕</button>`:'');
const capb=()=>bx(`SALARY CAP ${used()}M / ${G.cap}M`,`<div class=bar><i style="width:${Math.min(100,used()/G.cap*100)}%"></i></div>`,'cap');
const card=(a,o={})=>{const u=a.slot=='DEF'||a.slot=='OL'?'#f33':a.slot=='K'?'#e8660e':'#5bc0f8';return `<div class=w><div class="cd ${o.f?'clk':''}" ${o.f?`onclick="${o.f}"`:''}><div class=ph style="background:${a.inj?'#888':u}"><b>${a.slot}</b>${smile(G.morale)}${face(a,ME().c)}</div><div class=nm>${a.name.split('.')[1]}${stars(a.ovr)}${o.s?`<div>$${a.sal}M</div>`:''}</div><div class=en><i style="width:${a.inj?0:cl(a.ovr,10,100)}%"></i></div></div>${o.c?`<div class=pill>${o.c}</div>`:''}</div>`};
function pick0(){ui(`<div class=ttl>SELECT YOUR TEAM</div><div class=r>Stronger teams have better players. Pick wisely!</div><div class=grid>`+TEAMS.map((t,i)=>`<div class=w><div class="cd clk" onclick="pickTeam(${i})"><div class=ph style="background:${t.h}">${face({sk:i%4,hr:i%4},t.c)}</div><div class=nm>${t.n}${stars(t.s+10)}<div>${t.a} &middot; ${i<4?'EAST':'WEST'}</div></div></div></div>`).join('')+'</div>')}
function pickTeam(i){const s=TEAMS[i].s;fresh();G.tm=i;G.team=SL.map(k=>mkP(k,cl(RI(s-8,s+4),50,92)));genFA();genDr();genTr();newSeason();newOpp();save();menu()}
function menu(){if(!(G.tm>=0))return pick0();const me=ME();
const nd=G.po?poBand():[G.wk-1,G.wk,G.wk+1].map(w=>{if(w<1||w>8)return'<div class=nd></div>';const o=G.sch[w-1];return `<div class=nd><div>WEEK ${w}</div><div>${o.h?'vs':'at'} ${TM(o.n).n}</div><i class="dot ${w<G.wk?'g':''}"></i><div>${G.hist[w]||'&nbsp;'}</div></div>`}).join('');
const dv=TEAMS.filter((_,i)=>(i>>2)==(G.tm>>2)).map(t=>({t,w:t.a==me.a?G.w:G.st[t.a][0],l:t.a==me.a?G.l:G.st[t.a][1]})).sort((a,b)=>b.w-a.w);
const fp=Math.round(cl(G.fans/2,0,100)),tips=['STRONG PLAYERS WIN GAMES!','TRADE DRAFT PICKS FOR STARS','KEEP MORALE HIGH TO AVOID FUMBLES','WIND AFFECTS FIELD GOALS'];
ui(hdr('RETRO GRIDIRON','Y'+G.yr)+`<div class=band>${nd}</div><div class=row>`+bx('CONF '+(G.tm<4?'A EAST':'A WEST'),`<table style="width:100%"><tr><td><td>W<td>L<td>T</tr>${dv.map(d=>`<tr class="${d.t.a==me.a?'me':''}"><td>${d.t.n}<td>${d.w}<td>${d.l}<td>0</tr>`).join('')}</table>`,'half')+`<div class="half col">`+bx('FANS '+fp+'%',`<div class=bar><i style="width:${fp}%"></i></div>`)+`<div class=row>`+bx('MORALE',`${G.morale}% ${smile(G.morale)}`)+bx('OFFENSE',stars(mean([0,1,2,3,4,5]),'#5bc0f8'))+bx('DEFENSE',stars(mean([5,6,7]),'#f33'))+`</div></div></div><div class=r>TIP! ${pk(tips)}</div>
<div class=nav><button onclick=settings()>⚙</button><button onclick=fo()>FRONT OFFICE</button><button onclick=roster()>ROSTER</button><button onclick=dif()>LEVEL: ${DF().n}</button><button onclick=sstat()>STATS</button><button onclick="start(1)">2 PLAYER</button><button onclick="start(0)">CONTINUE ▶</button></div>`)}
function settings(){if(confirm('Start a new career and pick a different team?')){G.tm=-1;save();pick0()}}
function roster(){ui(hdr('ROSTER','','menu()')+`<div class=r>PLAYERS 8 / 8</div><div class=grid>${G.team.map((a,i)=>card(a,{s:1,f:`pl(${i})`})).join('')}</div><div class=nav><button onclick=menu()>⌂</button>${capb()}${bx('MORALE',G.morale+'% '+smile(G.morale))}${bx('OFFENSE',stars(mean([0,1,2,3,4,5]),'#5bc0f8'))}${bx('DEFENSE',stars(mean([5,6,7]),'#f33'))}</div>`)}
const POS={QB:['QUARTERBACK','THROW ACCURACY','ARM STRENGTH','SPEED'],WR:['WIDE RECEIVER','CATCHING','SPEED','AGILITY'],RB:['RUNNING BACK','RUSHING','SPEED','STRENGTH'],OL:['OFFENSIVE LINE','BLOCKING','STRENGTH','AWARENESS'],DEF:['DEFENSE','TACKLING','COVERAGE','SPEED'],K:['KICKER','KICK ACCURACY','KICK POWER','COMPOSURE']};
const hs=(s,k)=>{let h=k;for(const c of s)h=(h*31+c.charCodeAt(0))>>>0;return h};
function pl(i){const a=G.team[i],P=POS[a.slot],h=hs(a.name,1),age=a.age||21+h%12,pot=a.pot||Math.min(99,a.ovr+5+h%12),lv=Math.max(1,Math.floor((a.ovr-45)/8)),mo=G.morale>70?'GREAT':G.morale>50?'GOOD':G.morale>30?'BAD':'TERRIBLE';
const at=[1,2,3].map((k)=>[P[k],cl(a.ovr+(hs(a.name,k+2)%21)-10,20,99)]).concat([['STAMINA',cl(70+hs(a.name,9)%30,50,100)]]);
const val=a.ovr>=85?'RND 1 PICK':a.ovr>=75?'RND 2 PICK':a.ovr>=65?'RND 4 PICK':'RND 7 PICK';
ui(`<button class=x onclick=roster()>✕</button><div class=ttl>${a.slot} - ${a.name.toUpperCase()}</div><div class=row>`+bx(P[0],`<div class=det>AGE: ${age}${age<=22?' ROOKIE <i class=sm style="background:#fd0;color:#000;width:auto;padding:0 3px">R</i>':''}<br>CONTRACT: $${a.sal}M (${1+h%3}Y)<br>MORALE: ${mo} ${smile(G.morale)}<br>CONDITION: ${a.inj?'INJURED':'OK'}<br>VALUE: ${val}</div><div class=row style="margin-top:14px"><div>RATING<br>${stars(a.ovr)}</div><div>POTENTIAL<br>${stars(pot)}</div></div>`+bx('XP LEVEL '+lv,`<div class=bar><i style="width:${20+h%70}%"></i></div>`),'half')+bx('ATTRIBUTES',at.map(([n,v])=>`<div class=det>${n}</div><div class=bar><i style="width:${v}%"></i></div>`).join(''),'half')+`</div><div class=nav><button onclick="pl(${(i+7)%8})">◀</button><button onclick=roster()>←</button><button onclick="alert('Your 8 starters are the whole squad right now.')">BENCH</button><button onclick="ps(${i})">STATS</button><button onclick="meet(${i})">MEETING</button><button onclick="trd(${i})">TRADE</button><button onclick="pl(${(i+1)%8})">▶</button></div>`)}
function meet(i){const k=G.wk+'-'+G.yr;if(G.mtg==k)return alert('You already held a meeting this week.');G.mtg=k;G.morale=Math.min(100,G.morale+3);save();pl(i)}
function trd(i){const a=G.team[i];if(!confirm('Trade '+a.name+' for a draft pick? A weaker backup takes his spot.'))return;G.picks++;G.team[i]=mkP(a.slot,Math.max(50,a.ovr-15));save();roster()}
const DF=()=>[{n:'ROOKIE',b:-6,sp:.93,rd:-.5,ik:.7,cr:1},{n:'PRO',b:0,sp:1,rd:0,ik:1,cr:1},{n:'ALL-PRO',b:6,sp:1.06,rd:.5,ik:1.3,cr:1.25},{n:'LEGEND',b:12,sp:1.12,rd:1,ik:1.6,cr:1.5}][G.diff??1];
function dif(){G.diff=((G.diff??1)+1)%4;save();menu()}
/* stats + playoffs */
const newStats=()=>({cmp:0,att:0,pyd:0,ptd:0,int:0,ryd:0,rtd:0,sk:0,fgm:0,fga:0,pf:0,pa:0,gp:0,rec:{}});
const S=()=>{if(g&&g.poss==0&&!g.p2){G.stats=G.stats||newStats();return G.stats}return null};
function stat(gain,o){const s=S();if(!s)return;const m=o.msg||'';if(m.includes('INTERCEPT')){s.int++;return}if(m.includes('SACK')){s.sk++;return}if(o.to||o.inc)return;
const td=o.td||g.ball+gain>=100;if(p.kind=='run'){s.ryd+=gain;if(td)s.rtd++}else{s.pyd+=gain;s.cmp++;if(td)s.ptd++;const r=p.car?p.car.i:0;if(r){const q=s.rec[r]=s.rec[r]||[0,0,0];q[0]++;q[1]+=gain;if(td)q[2]++}}}
const rate=s=>{if(!s.att)return 0;const c=v=>cl(v,0,2.375);return Math.round((c((s.cmp/s.att-.3)*5)+c((s.pyd/s.att-3)*.25)+c(s.ptd/s.att*20)+c(2.375-s.int/s.att*25))/6*100)};
const ln=(a,b)=>`<div class=det>${a}: ${b}</div>`;
function sstat(){const s=G.stats||newStats(),gp=Math.max(1,s.gp),rl=[1,2,3,4].map(i=>{const q=s.rec[i]||[0,0,0],t=G.team[i];return `<tr><td>${t.slot} ${t.name}<td>${q[0]} rec<td>${q[1]} yds<td>${q[2]} TD</tr>`}).join('');
const pv=G.prev?`<div class=r>LAST SEASON: ${G.prev.pyd} pass yds, ${G.prev.ryd} rush yds, ${G.prev.ptd+G.prev.rtd} TD, ${G.prev.pf}-${G.prev.pa} pts</div>`:'';
ui(hdr('SEASON STATS','Y'+G.yr,'menu()')+`<div class=row>`+bx('TEAM',ln('GAMES',s.gp)+ln('POINTS FOR',s.pf+' ('+(s.pf/gp).toFixed(1)+'/g)')+ln('POINTS AGAINST',s.pa+' ('+(s.pa/gp).toFixed(1)+'/g)')+ln('TITLES',G.titles||0),'half')+bx('PASSING',ln('CMP/ATT',s.cmp+'/'+s.att)+ln('YARDS',s.pyd)+ln('TD / INT',s.ptd+' / '+s.int)+ln('SACKED',s.sk)+ln('RATING',rate(s)),'half')+bx('RUSHING & KICKING',ln('RUSH YARDS',s.ryd)+ln('RUSH TD',s.rtd)+ln('FIELD GOALS',s.fgm+'/'+s.fga),'half')+bx('RECEIVING',`<table>${rl}</table>`,'half')+`</div>${pv}<div class=nav><button onclick=menu()>⌂</button></div>`)}
function ps(i){const a=G.team[i],s=G.stats||newStats(),q=s.rec[i]||[0,0,0];let h='';
if(a.slot=='QB')h=ln('CMP/ATT',s.cmp+'/'+s.att)+ln('YARDS',s.pyd)+ln('TD / INT',s.ptd+' / '+s.int)+ln('RATING',rate(s));
else if(a.slot=='WR')h=ln('CATCHES',q[0])+ln('YARDS',q[1])+ln('TD',q[2]);
else if(a.slot=='RB')h=ln('RUSH YARDS',s.ryd)+ln('RUSH TD',s.rtd)+ln('CATCHES',q[0])+ln('REC YARDS',q[1]);
else if(a.slot=='K')h=ln('FG MADE',s.fgm+'/'+s.fga);
